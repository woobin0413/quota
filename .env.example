# =====================================================
# Quota Environment Variables
# =====================================================
# Copy this file to .env.local and fill in your values
# cp .env.example .env.local
# =====================================================

# =====================================================
# SUPABASE
# =====================================================
# Local development: run `supabase start` and copy the printed
# API URL / anon key / service_role key.
# Cloud: Supabase Dashboard → Settings → API

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# =====================================================
# AUTHENTICATION (Auth0)
# =====================================================
# Get these from: Auth0 Dashboard → Applications → Quota → Settings
# AUTH0_SECRET: generate with `openssl rand -hex 32`

AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_MGMT_DOMAIN=      # canonical tenant domain; Management API audience never moves to a custom domain.
                        #   Unset falls back to AUTH0_DOMAIN — correct as long as AUTH0_DOMAIN is still
                        #   the tenant domain and not yet switched to a custom domain.
AUTH0_MGMT_CLIENT_ID=   # M2M app. Scopes: read:users update:users (verification resend),
AUTH0_MGMT_CLIENT_SECRET=  #   update:prompts read:branding update:branding (branding script),
                           #   read:emails update:emails (email provider script),
                           #   delete:users (e2e teardown only)
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# Mobile API (native iOS/Android clients — see docs/api/v1.md)
AUTH0_AUDIENCE=https://api.sendquota.com   # Auth0 API identifier; bearer tokens are verified against it
AUTH0_MOBILE_SCHEME=com.sendquota.app      # optional; native callback scheme, used by scripts/auth0-mobile-api.mjs
                                           #   AUTH0_MOBILE_CLIENT_ID belongs in the mobile repo, not here —
                                           #   this app never authenticates as the native client.

# =====================================================
# BILLING (Stripe) — test mode; swap to live at launch
# =====================================================

STRIPE_SECRET_KEY=       # sk_test_… (Dashboard → Developers → API keys)
STRIPE_PRICE_PRO=        # price_… for Quota Pro $15/mo
STRIPE_PRICE_ULTIMATE=   # price_… for Quota Ultimate $29/mo
STRIPE_WEBHOOK_SECRET=   # whsec_… from `stripe listen` (dev) or dashboard endpoint (prod)
ALLOW_DEV_TIER_SWITCH=  # dev/e2e only — enables PATCH /api/subscription; NEVER set in prod

# =====================================================
# OPS
# =====================================================

CRON_SECRET=     # guards /api/cron/* (openssl rand -hex 32)
ADMIN_EMAILS=    # comma-separated emails allowed into /admin

# =====================================================
# EMAIL (Resend)
# =====================================================
# Get these from: https://resend.com/api-keys
# Set RESEND_MOCK=1 to bypass real sends (used by e2e tests)

RESEND_API_KEY=re_...
RESEND_WEBHOOK_SECRET=whsec_...   # Resend → Settings → Webhooks; route 500s without it
RESEND_MOCK=
RESEND_FROM_EMAIL=      # from-address on a verified domain; defaults to onboarding@resend.dev
RESEND_TEST_REDIRECT=   # optional: route ALL sends here before the domain is verified. NEVER set in prod

# =====================================================
# E2E TESTING (Playwright)
# =====================================================
# Auth0 test user in the Username-Password-Authentication connection

E2E_AUTH0_USER_EMAIL=
E2E_AUTH0_USER_PASSWORD=

# =====================================================
# APPLICATION
# =====================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional private operational configuration (never commit actual values)
QUOTA_DMARC_REPORT_EMAIL=
QUOTA_PRODUCTION_SUPABASE_URL=
QUOTA_PRODUCTION_SUPABASE_ANON_KEY=
QUOTA_PREVIEW_SUPABASE_URL=
QUOTA_PREVIEW_SUPABASE_ANON_KEY=

# Auth0 email-template configuration; private postal address stays server-side
QUOTA_POSTAL_ADDRESS=
QUOTA_SUPPORT_EMAIL=
AUTH0_LOGO_URL=

# Optional: link the synthetic seed to your own LOCAL Auth0 account after db reset
E2E_AUTH0_USER_ID=

# Local production-build E2E only; never configure on a hosted deployment
QUOTA_LOCAL_E2E=
